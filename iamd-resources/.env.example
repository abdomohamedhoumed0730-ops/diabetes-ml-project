# --- Supabase (Project Settings → API) -----------------------------------------
# URL du projet et clé publique (« publishable » ou « anon ») : exposées au navigateur,
# leur sécurité repose sur les règles RLS définies dans supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Site ------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Coordonnées affichées publiquement dans le pied de page et les mentions légales
# (chaque ligne est facultative ; laissée vide, elle n'est pas affichée)
NEXT_PUBLIC_CONTACT_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# --- SECRET : uniquement pour scripts/create-admin.mjs et les tests -------------
# Clé « secret » / service_role : accès total à la base. Ne JAMAIS la préfixer par
# NEXT_PUBLIC_, ne jamais la commiter, ne pas la définir sur Vercel (inutile à l'application).
SUPABASE_SECRET_KEY=
