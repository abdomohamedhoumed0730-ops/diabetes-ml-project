# --- Supabase (Project Settings → API) -----------------------------------------
# URL du projet et clé publique (« publishable » ou « anon ») : exposées au navigateur,
# leur sécurité repose sur les règles RLS définies dans supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Site ------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Adresse affichée dans le pied de page et les mentions légales (laisser vide si aucune)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- SECRET : uniquement pour scripts/create-admin.mjs et les tests -------------
# Clé « secret » / service_role : accès total à la base. Ne JAMAIS la préfixer par
# NEXT_PUBLIC_, ne jamais la commiter, ne pas la définir sur Vercel (inutile à l'application).
SUPABASE_SECRET_KEY=
